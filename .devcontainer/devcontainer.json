{
  "name": "Java REST API Examples",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.13-noble",
  "features": {
    "ghcr.io/devcontainers/features/java:1.8.3": {
      "version": "25.5.5.0+3-graalce",
      "jdkDistro": "graalce",
      "additionalVersions": "27.0.0.0+35-tem",
      "installMaven": "true",
      "mavenVersion": "3.9.16",
      "installGradle": "false"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
